rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ─────────────────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidImageType() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidVideoType() {
      return request.resource.contentType.matches('video/.*');
    }

    function isValidAudioType() {
      return request.resource.contentType.matches('audio/.*');
    }

    function isValidFontType() {
      return request.resource.contentType in [
        'font/woff2', 'font/woff', 'font/ttf', 'font/otf',
        'application/font-woff', 'application/font-woff2'
      ];
    }

    function fileSizeUnder(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024;
    }

    // ─────────────────────────────────────────────────────────────────────
    // users/{uid}/assets/images/{filename}
    //   Máx. 20 MB por imagen
    // ─────────────────────────────────────────────────────────────────────
    match /users/{uid}/assets/images/{filename} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && isValidImageType()
        && fileSizeUnder(20);
      allow delete: if isOwner(uid);
    }

    // ─────────────────────────────────────────────────────────────────────
    // users/{uid}/assets/videos/{filename}
    //   Máx. 500 MB por video
    // ─────────────────────────────────────────────────────────────────────
    match /users/{uid}/assets/videos/{filename} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && isValidVideoType()
        && fileSizeUnder(500);
      allow delete: if isOwner(uid);
    }

    // ─────────────────────────────────────────────────────────────────────
    // users/{uid}/assets/audio/{filename}
    //   Máx. 50 MB por audio
    // ─────────────────────────────────────────────────────────────────────
    match /users/{uid}/assets/audio/{filename} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && isValidAudioType()
        && fileSizeUnder(50);
      allow delete: if isOwner(uid);
    }

    // ─────────────────────────────────────────────────────────────────────
    // users/{uid}/assets/fonts/{filename}
    //   Máx. 5 MB por fuente
    // ─────────────────────────────────────────────────────────────────────
    match /users/{uid}/assets/fonts/{filename} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && isValidFontType()
        && fileSizeUnder(5);
      allow delete: if isOwner(uid);
    }

    // ─────────────────────────────────────────────────────────────────────
    // users/{uid}/exports/{filename}
    //   Escritura solo desde Admin SDK (renders del servidor).
    //   El propietario puede leer y eliminar sus exports.
    // ─────────────────────────────────────────────────────────────────────
    match /users/{uid}/exports/{filename} {
      allow read: if isOwner(uid);
      allow write: if false;  // Solo Admin SDK
      allow delete: if isOwner(uid);
    }

    // ─────────────────────────────────────────────────────────────────────
    // templates/thumbnails/{filename}
    //   Lectura pública (para el selector de plantillas).
    //   Escritura solo desde Admin SDK.
    // ─────────────────────────────────────────────────────────────────────
    match /templates/thumbnails/{filename} {
      allow read: if true;
      allow write: if false;  // Solo Admin SDK
    }

    // ─────────────────────────────────────────────────────────────────────
    // Bloquear cualquier otra ruta
    // ─────────────────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
