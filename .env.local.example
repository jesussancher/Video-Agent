# ──────────────────────────────────────────────────────
# Firebase (cliente) — variables públicas
# ──────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD35avrv9uT7V9OkbshAa2WHUgg_VicikU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lait-video-editor.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lait-video-editor

# ──────────────────────────────────────────────────────
# Firebase Admin SDK (servidor) — descarga el service account desde:
# Firebase Console → Configuración del proyecto → Cuentas de servicio
# → Generar nueva clave privada
# ──────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=lait-video-editor
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lait-video-editor.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ──────────────────────────────────────────────────────
# Sesión — clave secreta para firmar las cookies JWT
# Genera una con: openssl rand -base64 32
# ──────────────────────────────────────────────────────
SESSION_SECRET=tu_clave_secreta_de_al_menos_32_caracteres
